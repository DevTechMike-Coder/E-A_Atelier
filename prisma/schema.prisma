// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  bags
  wearables
  accessories
  home
}

enum ProductStatus {
  MADE_ON_DEMAND  @map("Made on Demand")
  IN_STOCK        @map("In Stock")
  LIMITED_EDITION @map("Limited Edition")
  CAPSULE_PREVIEW @map("Capsule Preview")
}

enum Currency {
  NGN
  USD
  EUR
  GBP
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  REVIEWED
  SCHEDULED
  COMPLETED
}

model Product {
  id                String          @id
  name              String
  tagline           String
  priceUSD          Decimal         @db.Decimal(10, 2)
  category          ProductCategory
  categoryLabel     String
  craftHours        Int
  fiber             String
  badge             String
  status            ProductStatus
  editionNumber     String?
  description       String          @db.Text
  storyQuote        String?         @db.Text
  provenance        String          @db.Text
  dimensions        String[]
  refCode           String          @unique
  isWearablePreview Boolean         @default(false)

  specBody           String
  specStructuralRope String
  specHardware       String
  specDyeChemistry   String
  specCare           String
  specLineage        String
  specShipping       String

  images     ProductImage[]
  colorways  ProductColorway[]
  reviews    Review[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductColorway {
  id        String  @id @default(cuid())
  name      String
  hex       String
  image     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  customerEmail String
  customerName  String
  currency      Currency
  fxRate        Decimal     @db.Decimal(10, 4)
  subtotalUSD   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)

  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingRegion  String?
  shippingPostal  String?
  shippingCountry String

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  colorway     String
  dimension    String
  quantity     Int
  unitPriceUSD Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model BespokeCommission {
  id            String           @id @default(cuid())
  referenceCode String           @unique @default(cuid())
  name          String
  email         String
  productName   String?
  palette       String
  notes         String?          @db.Text
  status        CommissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([email])
  @@index([status])
}
